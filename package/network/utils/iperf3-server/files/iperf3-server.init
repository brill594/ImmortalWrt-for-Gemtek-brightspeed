#!/bin/sh /etc/rc.common

START=99
STOP=10
USE_PROCD=1

start_service() {
	local address device

	. /lib/functions/network.sh
	network_flush_cache
	network_get_ipaddr address lan || return 0
	network_get_device device lan || return 0
	[ -n "$address" ] && [ -n "$device" ] || return 0

	procd_open_instance
	# Bind the device too: a WAN packet addressed to the LAN IP must not match.
	procd_set_param command /usr/bin/iperf3 -s -4 -B "$address" --bind-dev "$device" -p 5201
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger network
	procd_add_interface_trigger "interface.*" lan /etc/init.d/iperf3-server restart
}
